# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
# Load before running the app, e.g.:
#   export $(grep -v '^#' .env | xargs) && mvn spring-boot:run -Dspring-boot.run.arguments=--spring.profiles.active=snow-live
# or use a tool like `direnv` / `dotenv-cli` to auto-load it.

# --- ServiceNow (required for --spring.profiles.active=snow-live or =real) ---
SNOW_BASE_URL=https://devNNNNN.service-now.com
SNOW_USER=
SNOW_PASSWORD=

# --- Confluence (only needed for --spring.profiles.active=real) ---
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# --- Sumo Logic (only needed for --spring.profiles.active=real) ---
SUMO_BASE_URL=
SUMO_ACCESS_ID=
SUMO_ACCESS_KEY=

# --- GitLab (only needed for --spring.profiles.active=real) ---
GITLAB_BASE_URL=
GITLAB_TOKEN=

# --- Live ADK agent mode (only needed for -Padk with --triage.engine=adk) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
