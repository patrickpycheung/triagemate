# Copy to secrets.properties (same directory) and fill in real values.
# secrets.properties is gitignored — never commit it.
#
# This is a standard Java .properties file. Spring Boot auto-imports it via
#   spring.config.import: optional:file:secrets.properties   (see application.yml)
# so the values below override the built-in blanks — no shell `export` needed.
# Just run, e.g.:
#   ./run-deterministic-real.sh          # real connectors, scripted engine
#   ./run-adk-real.sh                    # real connectors, live ADK agent
#
# FND-73: earlier revisions of this file named a `snow-live` profile. It does not exist
# (application.yml defines exactly one profile, `real`) and Spring accepts an unknown
# active profile SILENTLY — so following that instruction left every connector on the
# in-memory mock while looking like a live run. Switch connectors individually instead:
#   -Dtriage.connectors.servicenow=real   (and/or confluence / sumo / gitlab)
#
# You only need the blocks for the connectors you switch to `real`; leave the rest
# blank for the offline demo.

# --- ServiceNow (required when triage.connectors.servicenow=real) ---
triage.integrations.servicenow.base-url=https://devNNNNN.service-now.com
triage.integrations.servicenow.user=
triage.integrations.servicenow.secret=

# --- Confluence (only needed when triage.connectors.confluence=real) ---
# base-url: the SITE ROOT, with NO /wiki suffix — the app adds the /wiki context path
# itself (FND-83). Both spellings are accepted since 2026-08-05, but the bare site root is
# the canonical form:  https://<site>.atlassian.net
triage.integrations.confluence.base-url=
triage.integrations.confluence.user=
triage.integrations.confluence.secret=

# --- Sumo Logic (only needed when triage.connectors.sumo=real) ---
triage.integrations.sumo.base-url=
triage.integrations.sumo.user=
triage.integrations.sumo.secret=

# --- GitLab (only needed when triage.connectors.gitlab=real) ---
triage.integrations.gitlab.base-url=
triage.integrations.gitlab.token=

# --- Live ADK agent mode (only needed for -Padk with --triage.engine=adk) ---
# base-url: the local Copilot proxy, e.g. http://localhost:4000/v1 (see bin/setup-copilot-api.sh)
# api-key:  anything non-empty — an OAuth-backed proxy ignores it
# model:    MUST be a HIGH tier. D1's whole claim is "a frontier model, on rails", and D3's
#           contrast asserts the model is the SAME one Copilot CLI uses — both are false if
#           this is left on a mini model. Verified available on the corp seat (2026-07-30,
#           31 models exposed): claude-opus-4.6, claude-sonnet-5, gpt-5.3-codex, gpt-5.4.
#           Confirm with: curl -s http://localhost:4000/v1/models | jq -r '.data[].id'
triage.integrations.llm.base-url=http://localhost:4000/v1
# NOT a secret and NOT optional: an OAuth-backed proxy ignores the value, but
# AdkModelFactory.require() throws if it is BLANK — and that throw now degrades to the
# deterministic engine, so the app returns HTTP 200 and a plausible report while never
# calling the model at all. Leave a placeholder here; do not blank it.
triage.integrations.llm.api-key=ignored-by-oauth-proxy
triage.integrations.llm.model=claude-opus-4.6
